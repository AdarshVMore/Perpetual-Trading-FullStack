# ---------------------------------------------------------------------------
# Local dev: use the Vite proxy (see vite.config.ts) — same-origin, no CORS.
# ---------------------------------------------------------------------------
VITE_API_URL=/api/v1
VITE_WS_URL=ws://localhost:8080

# ---------------------------------------------------------------------------
# Production (set these in the Vercel project → Settings → Environment
# Variables). Vite bakes them in at build time, so redeploy after changing.
# Use the exact service URLs Render gives you after the first deploy.
# ---------------------------------------------------------------------------
# VITE_API_URL=https://perp-api.onrender.com/api/v1
# VITE_WS_URL=wss://perp-ws.onrender.com

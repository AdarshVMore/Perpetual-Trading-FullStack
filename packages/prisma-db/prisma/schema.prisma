// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @default(cuid())  @id
  email             String            @unique
  password          String
  orders            Orders[]
//  position        Positions[]
}

model Fills {
  id                String           @default(cuid())  @id
  userId            String
  user              User             @relation(fields:[userId], references: [id])
  orderId           String
  order             Orders           @relation(fields:[orderId], references: [id])
  makerId           String            
  takerId           String
  filledQty         Int
  remainingQty      Int
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Orders {
  id                String            @default(cuid())  @id
  userId            String
  user              User               @relation(fields:[userId], references: [id])
  price             Int?
  qty               Int
  leverage          Int
  Margin            Int?
  marketId          String            
  orderType        OrderType  
  fills             Fills[]             
  orderStatus       OrderStatus
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

model Positions {
  id                        String           @default(cuid())  @id
  userId                    String
  user                      User               @relation(fields:[userId], references: [id])
  marketId                  String
  positionType              PositionType
  qty                       Int
  leverage                  Int
  margin                    Int
  maintainanceMargin        Int
  liquidationPrice          Int
  pnL                       Int
  entryPrice                Int
  averagePrice              Int
  unrealisedPnL             Int
}


model Markets {
  id               String            @default(cuid())  @id
  symbol           String
  market           String
}


enum OrderType {
  MARKET
  LIMIT
}

enum PositionType {
  LONG
  SHORT
}

enum PositionStatus {
  OPEN
  CLOSE
}

enum OrderStatus {
  OPEN
  FILLED
  PARTIALLY_FILLED

}
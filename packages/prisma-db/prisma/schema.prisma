// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  password    String
  orders      Orders[]
  fills       Fills[]
  positions   Positions[]
  userBalance UserBalance[]
}

model Fills {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  orderId      String
  order        Orders   @relation(fields: [orderId], references: [id])
  marketId     String
  makerId      String
  market       Markets  @relation(fields: [marketId], references: [id])
  takerId      String
  originalQty  Float
  filledQty    Float
  remainingQty Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Orders {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  price       Float?
  qty         Float
  leverage    Int
  Margin      Float?
  marketId    String
  market      Markets     @relation(fields: [marketId], references: [id])
  orderType   OrderType
  fills       Fills[]
  orderStatus OrderStatus
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Positions {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id])
  marketId           String
  market             Markets        @relation(fields: [marketId], references: [id])
  positionType       PositionType
  qty                Float
  leverage           Int
  margin             Float
  maintainanceMargin Float
  liquidationPrice   Float
  realisedPnL        Float
  entryPrice         Float
  averagePrice       Float
  unrealisedPnL      Float
  openedAt           DateTime       @default(now())
  closedAt           DateTime       @updatedAt
  status             PositionStatus
}

model UserBalance {
  id               String   @default(cuid())  @unique
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  availableBalance Float
  lockedBalance    Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Markets {
  id          String @id @default(cuid())
  symbol      String
  market      String
  maxLeverage Int
  orders      Orders[]
  positions   Positions[]
  fills       Fills[]
}

enum OrderType {
  MARKET
  LIMIT
}

enum PositionType {
  LONG
  SHORT
}

enum PositionStatus {
  OPEN
  CLOSE
}

enum OrderStatus {
  OPEN
  FILLED
  PARTIALLY_FILLED
  CANCLED
  REJECTED
}
